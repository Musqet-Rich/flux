#!/bin/sh
# Commit-msg: enforce Conventional Commits (docs/engineering.md § Git).
#   <type>(<scope>)?!?: <subject>
# types:   feat fix docs chore refactor test ci build
# scopes:  daemon relay pwa protocol docs repo   (optional; nothing else accepted)
# subject: non-empty, no leading space, whole line at most 100 characters.
# Merge/revert/fixup/squash subjects generated by git are allowed through.
# Reads the message file git passes as $1 (never a hardcoded .git path, so
# worktrees work). Skips blank and comment lines that a cleanup pass would
# remove, so the first real line is what is validated. POSIX sh, no deps.
# Also run by CI against the pull request title and every commit in the PR
# (.github/workflows/ci.yml, job "commits"), because PRs are squash-merged and
# the local hook can be skipped with --no-verify.
set -eu

if [ "$#" -lt 1 ] || [ ! -r "$1" ]; then
  echo "commit-msg: expected a readable message file as \$1" >&2
  exit 1
fi
msg_file=$1

# core.commentChar may be a single character or "auto". With "auto" git picks
# the first of "#;@!$%^&|:" that does not start any line of the message; a
# Conventional Commit subject never starts with "#", so "#" is the char git
# will have chosen whenever the message is valid, and an invalid message is
# refused either way. Matching is done with `case`, not a grep bracket
# expression, so characters such as "]" or "^" are safe.
comment_char=$(git config --get core.commentChar 2>/dev/null || true)
case "$comment_char" in
  ''|auto) comment_char='#' ;;
esac

subject=
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "$comment_char"*) continue ;;
  esac
  if [ -z "$(printf '%s' "$line" | tr -d '[:space:]')" ]; then
    continue
  fi
  subject=$line
  break
done <"$msg_file"

if [ -z "$subject" ]; then
  echo "commit-msg: empty commit message" >&2
  exit 1
fi

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|chore|refactor|test|ci|build'
scopes='daemon|relay|pwa|protocol|docs|repo'
pattern="^($types)(\\(($scopes)\\))?!?: [^[:space:]].*$"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<MSG
commit-msg: invalid commit message subject:
  $subject
Expected Conventional Commits:
  <type>(<scope>): <subject>
  type:  feat | fix | docs | chore | refactor | test | ci | build
  scope: daemon | relay | pwa | protocol | docs | repo   (optional)
Example: feat(daemon): add session supervisor
MSG
  exit 1
fi

len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt 100 ]; then
  echo "commit-msg: subject line is $len characters; maximum is 100" >&2
  exit 1
fi
