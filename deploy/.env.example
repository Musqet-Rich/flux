# Flux configuration. Every FLUX_* variable the daemon and the relay read, with its default.
# The systemd units load this file as /etc/flux/flux.env; for a shell, `node --env-file`.
# Both apps ignore the other's variables, so one file shape serves both machines.

# ---------------------------------------------------------------------------------------------
# Daemon (the box): apps/daemon/src/index.ts
# ---------------------------------------------------------------------------------------------

# Origin of your relay, as the phone will reach it through Caddy. Required by `flux daemon`,
# which refuses to start without it (exit 2, no restart), so an unedited copy cannot run.
#FLUX_RELAY_URL=https://flux.example.com

# State directory: SQLite event log, box keypair, VAPID key, control socket, per-session MCP
# configs. Default ~/.flux. `flux pair` and `flux devices` look here too.
#FLUX_DATA_DIR=/home/flux/.flux

# Directory whose subdirectories are the git repositories agents work in. Default ~/repos.
# Only the starting value: once changed from the PWA's Settings screen, the stored value wins.
#FLUX_REPOS_DIR=/home/flux/repos

# The agent's global config directory, whose CLAUDE.md and settings.json the PWA's Settings
# screen edits. Default ~/.claude of the user running the daemon.
#FLUX_CLAUDE_DIR=/home/flux/.claude

# The Claude Code binary. Default `claude` on PATH.
#FLUX_CLAUDE=/home/flux/.local/bin/claude

# VAPID subject (RFC 8292): a mailto: or https: URL a push service may contact about abuse.
# Default https://<hostname>.
#FLUX_PUSH_SUBJECT=mailto:you@example.com

# Set to 1 when the terminal is light-on-dark inverted (light background) and the pairing QR
# does not scan. Only read by `flux daemon` and `flux pair` when stdout is a terminal.
#FLUX_QR_INVERT=1

# Internal, set by the daemon for the flux-mcp process it configures per session; never set
# these yourself: FLUX_CONTROL_SOCKET, FLUX_SESSION.

# ---------------------------------------------------------------------------------------------
# Relay (the VPS): apps/relay/src/index.ts
# ---------------------------------------------------------------------------------------------

# Listen port. Default 8787; the Caddyfile proxies to it.
#FLUX_RELAY_PORT=8787

# Bind address. Default 127.0.0.1: only the reverse proxy on the same host can reach it.
#FLUX_RELAY_HOST=127.0.0.1

# Built PWA to serve. Default apps/pwa/dist beside the relay package (what `pnpm run build`
# produces), so it needs setting only if the PWA build lives elsewhere.
#FLUX_PWA_DIR=/opt/flux/apps/pwa/dist

# Set to 1 only behind a reverse proxy (the Caddyfile setup; flux-relay.service sets it). The
# per-IP connection limit then counts the last address in X-Forwarded-For instead of the
# proxy's 127.0.0.1. Never inferred: a relay reached directly must not trust that header.
#FLUX_TRUST_PROXY=1
