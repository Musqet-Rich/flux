{
  "extends": "../../tsconfig.base.json",
  // Zero runtime deps and no ambient types: the base's `types: []` stands.
  // isolatedDeclarations keeps every export's type explicit so tsdown can emit .d.ts
  // without the type-checker (docs/engineering.md § TypeScript).
  // lib adds DOM for the web-platform APIs the protocol uses (WebCrypto, TextEncoder,
  // CompressionStream). Node 24 implements the same globals, so the package stays usable on
  // both ends without ambient Node types.
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "declaration": true,
    "isolatedDeclarations": true
  },
  "include": ["src/**/*.ts"]
}
